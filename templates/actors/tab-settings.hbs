<section class="tab {{#if (eq activeTab "settings")}}active{{/if}}" data-tab="settings" data-group="main">
  <div class="form-group">
    <label>{{localize "RT.Sheet.Edition"}}</label>
    <div class="form-fields">
      <select class="rt-edition-select">
        {{#each editions as |edition|}}
        <option value="{{edition.id}}" {{#if edition.selected}}selected{{/if}}>{{localize edition.label}}</option>
        {{/each}}
      </select>
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "RT.Settings.Sheet.FreeSkillChars"}}</label>
    <div class="form-fields">
      <input type="checkbox" name="system.settings.freeSkillChars" {{checked system.settings.freeSkillChars}}/>
    </div>
    <p class="rt-settings-hint">{{localize "RT.Settings.Sheet.FreeSkillCharsHint"}}</p>
  </div>

  <section class="rt-stub-note">
    <p>{{localize "RT.Sheet.SettingsNote"}}</p>
  </section>
</section>
