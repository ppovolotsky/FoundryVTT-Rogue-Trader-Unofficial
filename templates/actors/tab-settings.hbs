<section class="tab {{#if (eq activeTab "settings")}}active{{/if}}" data-tab="settings" data-group="main">
  <div class="form-group">
    <label>{{localize "RT.Sheet.Edition"}}</label>
    <div class="form-fields">
      <select class="rt-edition-select">
        {{#each editions as |edition|}}
        <option value="{{edition.id}}" {{#if edition.selected}}selected{{/if}}>{{localize edition.label}}</option>
        {{/each}}
      </select>
    </div>
  </div>

  <div class="rt-settings-divider"></div>

  <div class="rt-settings-toggle">
    <input type="checkbox" name="system.settings.freeSkillChars" id="rt-free-skill-chars" {{checked system.settings.freeSkillChars}}/>
    <label for="rt-free-skill-chars">{{localize "RT.Settings.Sheet.FreeSkillChars"}}</label>
    <i class="fa-solid fa-circle-question rt-skill-help" data-tooltip="{{localize "RT.Settings.Sheet.FreeSkillCharsHint"}}"></i>
  </div>

  <section class="rt-stub-note">
    <p>{{localize "RT.Sheet.SettingsNote"}}</p>
  </section>
</section>
