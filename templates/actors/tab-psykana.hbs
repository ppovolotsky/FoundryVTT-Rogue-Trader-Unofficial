<section class="tab {{#if (eq activeTab "psykana")}}active{{/if}}" data-tab="psykana" data-group="main">
  <div class="rt-psykana-toggle-row">
    <button type="button" class="rt-button rt-psykana-toggle" data-action="togglePsyType">
      {{#if (eq system.psykana.type "navigator")}}{{localize "RT.Psykana.Navigator"}}{{else}}{{localize "RT.Psykana.Psyker"}}{{/if}}
    </button>
  </div>

  {{#if (eq system.psykana.type "navigator")}}
  <div class="rt-psykana-columns">

    <div class="rt-psykana-column">
      <h3 class="rt-sheet-section__title">{{localize "RT.Psykana.Lineage"}}</h3>
      <input type="text" class="rt-psykana-lineage" name="system.psykana.lineage" value="{{system.psykana.lineage}}"/>

      <h3 class="rt-sheet-section__title">{{localize "RT.Psykana.LineageBenefits"}}</h3>
      <div class="rt-talents-list" data-list-shell="lineageBenefits">
        {{#each lineageBenefits as |p|}}
        <div class="rt-talent-block" data-block-index="{{p.index}}">
          <div class="rt-talent-block__header">
            <input type="text" data-jlist="lineageBenefits" data-jindex="{{p.index}}" data-jfield="name" value="{{p.name}}" placeholder="{{localize "RT.Psykana.BenefitName"}}"/>
            <div class="rt-view-buttons">
              <button type="button" class="rt-button rt-button--small" data-action="toggleRowExpand" title="{{localize "RT.Talents.ShowDesc"}}"><i class="fa-solid fa-chevron-down"></i></button>
              <button type="button" class="rt-button rt-button--small" data-action="sendRowToChat" data-index="{{p.index}}" title="{{localize "RT.Talents.SendToChat"}}"><i class="fa-solid fa-comment-dots"></i></button>
            </div>
            <div class="rt-row-edit rt-hidden">
              <button type="button" class="rt-row-edit__btn" data-action="moveListRow" data-list="lineageBenefits" data-index="{{p.index}}" data-delta="-1" title="{{localize "RT.Skills.MoveUp"}}"><i class="fa-solid fa-arrow-up"></i></button>
              <button type="button" class="rt-row-edit__btn" data-action="moveListRow" data-list="lineageBenefits" data-index="{{p.index}}" data-delta="1" title="{{localize "RT.Skills.MoveDown"}}"><i class="fa-solid fa-arrow-down"></i></button>
              <button type="button" class="rt-row-edit__btn" data-action="deleteListRow" data-list="lineageBenefits" data-index="{{p.index}}" title="{{localize "RT.Skills.Delete"}}"><i class="fa-solid fa-trash"></i></button>
            </div>
          </div>
          <div class="rt-talent-block__body rt-hidden">
            <textarea class="rt-description" data-jlist="lineageBenefits" data-jindex="{{p.index}}" data-jfield="description" rows="4">{{p.description}}</textarea>
          </div>
        </div>
        {{/each}}
      </div>
      <div class="rt-skill-group-table__footer">
        <button type="button" class="rt-button rt-button--small" data-action="addListRow" data-list="lineageBenefits" title="{{localize "RT.Skills.Add"}}">+</button>
        <button type="button" class="rt-button rt-button--small" data-action="toggleListEdit" data-list-shell="lineageBenefits" title="{{localize "RT.Skills.EditRows"}}"><i class="fa-solid fa-gear"></i></button>
      </div>

      <h3 class="rt-sheet-section__title">{{localize "RT.Psykana.MutationsHeader"}}</h3>
      <div class="rt-psykana-mutation-row">
        <button type="button" class="rt-button" data-action="rollMutationTest" title="{{localize "RT.Psykana.MutationTestTitle"}}">{{localize "RT.Psykana.MutationTest"}}</button>
        <input type="number" name="system.psykana.mutationMod" value="{{system.psykana.mutationMod}}" data-dtype="Number" title="{{localize "RT.Psykana.MutationMod"}}"/>
        <button type="button" class="rt-button" data-action="rollMutationTable" title="{{localize "RT.Psykana.MutationTableTitle"}}">{{localize "RT.Psykana.MutationTable"}}</button>
      </div>

      <div class="rt-talents-list" data-list-shell="mutations">
        {{#each mutations as |m|}}
        <div class="rt-talent-block" data-block-index="{{m.index}}">
          <div class="rt-talent-block__header">
            <input type="text" data-jlist="mutations" data-jindex="{{m.index}}" data-jfield="name" value="{{m.name}}" placeholder="{{localize "RT.Psykana.MutationName"}}"/>
            <div class="rt-view-buttons">
              <button type="button" class="rt-button rt-button--small" data-action="toggleRowExpand" title="{{localize "RT.Talents.ShowDesc"}}"><i class="fa-solid fa-chevron-down"></i></button>
              <button type="button" class="rt-button rt-button--small" data-action="sendRowToChat" data-index="{{m.index}}" title="{{localize "RT.Talents.SendToChat"}}"><i class="fa-solid fa-comment-dots"></i></button>
            </div>
            <div class="rt-row-edit rt-hidden">
              <button type="button" class="rt-row-edit__btn" data-action="moveListRow" data-list="mutations" data-index="{{m.index}}" data-delta="-1" title="{{localize "RT.Skills.MoveUp"}}"><i class="fa-solid fa-arrow-up"></i></button>
              <button type="button" class="rt-row-edit__btn" data-action="moveListRow" data-list="mutations" data-index="{{m.index}}" data-delta="1" title="{{localize "RT.Skills.MoveDown"}}"><i class="fa-solid fa-arrow-down"></i></button>
              <button type="button" class="rt-row-edit__btn" data-action="deleteListRow" data-list="mutations" data-index="{{m.index}}" title="{{localize "RT.Skills.Delete"}}"><i class="fa-solid fa-trash"></i></button>
            </div>
          </div>
          <div class="rt-talent-block__body rt-hidden">
            <textarea class="rt-description" data-jlist="mutations" data-jindex="{{m.index}}" data-jfield="description" rows="4">{{m.description}}</textarea>
          </div>
        </div>
        {{/each}}
      </div>
      <div class="rt-skill-group-table__footer">
        <button type="button" class="rt-button rt-button--small" data-action="addListRow" data-list="mutations" title="{{localize "RT.Skills.Add"}}">+</button>
        <button type="button" class="rt-button rt-button--small" data-action="toggleListEdit" data-list-shell="mutations" title="{{localize "RT.Skills.EditRows"}}"><i class="fa-solid fa-gear"></i></button>
      </div>
    </div>

    <div class="rt-psykana-column">
      <h3 class="rt-sheet-section__title">{{localize "RT.Psykana.NavigatorPowers"}}</h3>
      <div class="rt-talents-list" data-list-shell="powers">
        {{#each powers as |p|}}
        <div class="rt-talent-block rt-power-block" data-block-index="{{p.index}}">
          <div class="rt-power-block__row rt-power-block__main">
            <div class="rt-field rt-power-block__name">
              <label>{{localize "RT.Psykana.PowerName"}}</label>
              <input type="text" data-jlist="powers" data-jindex="{{p.index}}" data-jfield="name" value="{{p.name}}"/>
            </div>
            <select class="rt-power-block__source" data-jlist="powers" data-jindex="{{p.index}}" data-jfield="source" title="{{localize "RT.Psykana.PowerSourceTitle"}}">
              {{#each p.sources as |s|}}
              <option value="{{s.id}}" {{#if s.selected}}selected{{/if}}>{{s.abbr}}</option>
              {{/each}}
            </select>
            <div class="rt-field rt-power-block__level">
              <label>{{localize "RT.Psykana.LevelNovice"}}</label>
              <input type="checkbox" data-jlist="powers" data-jindex="{{p.index}}" data-jfield="novice" {{checked p.novice}}/>
            </div>
            <div class="rt-field rt-power-block__level">
              <label>{{localize "RT.Psykana.LevelAdept"}}</label>
              <input type="checkbox" data-jlist="powers" data-jindex="{{p.index}}" data-jfield="adept" {{checked p.adept}}/>
            </div>
            <div class="rt-field rt-power-block__level">
              <label>{{localize "RT.Psykana.LevelMaster"}}</label>
              <input type="checkbox" data-jlist="powers" data-jindex="{{p.index}}" data-jfield="master" {{checked p.master}}/>
            </div>
            <div class="rt-field rt-power-block__mod">
              <label>{{localize "RT.Psykana.PowerMod"}}</label>
              <input type="number" data-jlist="powers" data-jindex="{{p.index}}" data-jfield="mod" value="{{p.mod}}" data-dtype="Number"/>
            </div>
            <button type="button" class="rt-skill-row__total rt-power-block__total" data-action="rollPower" data-index="{{p.index}}" title="{{localize "RT.Psykana.PowerTotalTitle"}}">{{p.total}}</button>
            <div class="rt-row-edit rt-hidden">
              <button type="button" class="rt-row-edit__btn" data-action="moveListRow" data-list="powers" data-index="{{p.index}}" data-delta="-1" title="{{localize "RT.Skills.MoveUp"}}"><i class="fa-solid fa-arrow-up"></i></button>
              <button type="button" class="rt-row-edit__btn" data-action="moveListRow" data-list="powers" data-index="{{p.index}}" data-delta="1" title="{{localize "RT.Skills.MoveDown"}}"><i class="fa-solid fa-arrow-down"></i></button>
              <button type="button" class="rt-row-edit__btn" data-action="deleteListRow" data-list="powers" data-index="{{p.index}}" title="{{localize "RT.Skills.Delete"}}"><i class="fa-solid fa-trash"></i></button>
            </div>
          </div>
          <div class="rt-power-block__row rt-power-block__details">
            <input type="text" placeholder="{{localize "RT.Psykana.PowerActivation"}}" data-jlist="powers" data-jindex="{{p.index}}" data-jfield="activation" value="{{p.activation}}"/>
            <input type="text" placeholder="{{localize "RT.Psykana.PowerRange"}}" data-jlist="powers" data-jindex="{{p.index}}" data-jfield="range" value="{{p.range}}"/>
            <input type="text" placeholder="{{localize "RT.Psykana.PowerDamage"}}" data-jlist="powers" data-jindex="{{p.index}}" data-jfield="damage" value="{{p.damage}}"/>
            <input type="text" placeholder="{{localize "RT.Psykana.PowerType"}}" data-jlist="powers" data-jindex="{{p.index}}" data-jfield="type" value="{{p.type}}"/>
            <button type="button" class="rt-button rt-button--small" data-action="rollPowerDamage" data-index="{{p.index}}" title="{{localize "RT.Psykana.PowerDamage"}}">{{localize "RT.Psykana.PowerDamage"}}</button>
            <button type="button" class="rt-button rt-button--small" data-action="sendRowToChat" data-index="{{p.index}}" title="{{localize "RT.Talents.SendToChat"}}"><i class="fa-solid fa-comment-dots"></i></button>
            <button type="button" class="rt-button rt-button--small" data-action="toggleRowExpand" title="{{localize "RT.Talents.ShowDesc"}}"><i class="fa-solid fa-chevron-down"></i></button>
          </div>
          <div class="rt-talent-block__body rt-hidden rt-power-block__body">
            <textarea class="rt-description" placeholder="{{localize "RT.Psykana.LevelNovice"}}" data-jlist="powers" data-jindex="{{p.index}}" data-jfield="descNovice" rows="2">{{p.descNovice}}</textarea>
            <textarea class="rt-description" placeholder="{{localize "RT.Psykana.LevelAdept"}}" data-jlist="powers" data-jindex="{{p.index}}" data-jfield="descAdept" rows="2">{{p.descAdept}}</textarea>
            <textarea class="rt-description" placeholder="{{localize "RT.Psykana.LevelMaster"}}" data-jlist="powers" data-jindex="{{p.index}}" data-jfield="descMaster" rows="2">{{p.descMaster}}</textarea>
          </div>
        </div>
        {{/each}}
      </div>
      <div class="rt-skill-group-table__footer">
        <button type="button" class="rt-button rt-button--small" data-action="addListRow" data-list="powers" title="{{localize "RT.Skills.Add"}}">+</button>
        <button type="button" class="rt-button rt-button--small" data-action="toggleListEdit" data-list-shell="powers" title="{{localize "RT.Skills.EditRows"}}"><i class="fa-solid fa-gear"></i></button>
      </div>
    </div>

  </div>
  {{else}}
  <section class="rt-stub-note">
    <p>{{localize "RT.Sheet.StubNote"}}</p>
  </section>
  {{/if}}
</section>
