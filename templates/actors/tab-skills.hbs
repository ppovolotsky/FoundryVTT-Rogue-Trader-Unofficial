<section class="tab {{#if (eq activeTab "skills")}}active{{/if}}" data-tab="skills" data-group="main">
  <div class="rt-skills-columns">
    <div class="rt-skills-column">
      <h3 class="rt-skills-column__title">{{localize "RT.Skills.Basic"}}</h3>
      {{#each skillsBasic as |s|}}
      <div class="rt-skill-row">
        <span class="rt-skill-row__name">{{s.name}}<i class="fa-solid fa-circle-question rt-skill-help" data-tooltip="{{s.desc}}"></i></span>
        <span class="rt-skill-row__char">{{s.charAbbr}}</span>
        <button type="button" class="rt-skill-row__total" data-action="rollSkill" data-skill="{{s.key}}">{{s.total}}</button>
      </div>
      {{/each}}
    </div>

    <div class="rt-skills-column">
      <h3 class="rt-skills-column__title">{{localize "RT.Skills.Advanced"}}</h3>
      {{#each skillsAdvanced as |s|}}
      <div class="rt-skill-row">
        <span class="rt-skill-row__name">{{s.name}}<i class="fa-solid fa-circle-question rt-skill-help" data-tooltip="{{s.desc}}"></i></span>
        <span class="rt-skill-row__char">{{s.charAbbr}}</span>
        <button type="button" class="rt-skill-row__total" data-action="rollSkill" data-skill="{{s.key}}">{{s.total}}</button>
      </div>
      {{/each}}

      <div class="rt-acquisition">
        <h3 class="rt-skills-column__title">{{localize "RT.Acquisition.Title"}}</h3>
        <div class="rt-acquisition__row">
          <button type="button" class="rt-button" data-action="rollAcquisition">{{localize "RT.Acquisition.Roll"}}</button>
          <input type="number" name="system.profitFactor" value="{{system.profitFactor}}" data-dtype="Number" aria-label="{{localize "RT.Acquisition.ProfitFactor"}}"/>
        </div>
        <div class="rt-acquisition__selects">
          <div class="rt-field">
            <label>{{localize "RT.Acquisition.AvailabilityTitle"}}</label>
            <select name="system.acquisition.availability">
              {{#each acquisition.availability as |option|}}
              <option value="{{option.id}}" {{#if option.selected}}selected{{/if}}>{{localize option.label}} ({{option.mod}})</option>
              {{/each}}
            </select>
          </div>
          <div class="rt-field">
            <label>{{localize "RT.Acquisition.QuantityComponents"}}</label>
            <select name="system.acquisition.scale">
              <optgroup label="{{localize "RT.Acquisition.Quantity"}}">
                {{#each acquisition.scale as |option|}}
                <option value="{{option.id}}" {{#if option.selected}}selected{{/if}}>{{localize option.label}} ({{option.mod}})</option>
                {{/each}}
              </optgroup>
              <optgroup label="{{localize "RT.Acquisition.ComponentsTitle"}}">
                {{#each acquisition.components as |option|}}
                <option value="{{option.id}}" {{#if option.selected}}selected{{/if}}>{{localize option.label}} ({{option.mod}})</option>
                {{/each}}
              </optgroup>
            </select>
          </div>
          <div class="rt-field">
            <label>{{localize "RT.Acquisition.QualityTitle"}}</label>
            <select name="system.acquisition.quality">
              {{#each acquisition.quality as |option|}}
              <option value="{{option.id}}" {{#if option.selected}}selected{{/if}}>{{localize option.label}} ({{option.mod}})</option>
              {{/each}}
            </select>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="rt-skills-groups">
    {{#each skillGroups as |g|}}
    <div class="rt-skill-group">
      <div class="rt-skill-group__header">{{g.name}}<i class="fa-solid fa-circle-question rt-skill-help" data-tooltip="{{g.desc}}"></i></div>
      {{#each g.rows as |r|}}
      <div class="rt-skill-row">
        <span class="rt-skill-row__name">{{r.name}}</span>
        <span class="rt-skill-row__char">{{r.charAbbr}}</span>
        <button type="button" class="rt-skill-row__total" data-action="rollGroupSkill" data-index="{{r.index}}">{{r.total}}</button>
      </div>
      {{/each}}
    </div>
    {{/each}}
  </div>
</section>
