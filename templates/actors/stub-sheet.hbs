<form class="{{cssClass}}" autocomplete="off">
  <header class="rt-sheet-header">
    <img class="rt-sheet-header__portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
    <input class="rt-sheet-header__name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize "RT.Sheet.Name"}}"/>
  </header>

  <section class="rt-stub-note">
    <p>{{localize "RT.Sheet.StubNote"}}</p>
  </section>

  <section class="rt-sheet-section">
    <label class="rt-sheet-section__title">{{localize "RT.Sheet.Description"}}</label>
    {{editor enrichedDescription target="system.description" button=true editable=editable}}
  </section>
</form>
