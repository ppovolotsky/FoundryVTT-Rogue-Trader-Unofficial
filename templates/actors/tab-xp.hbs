<section class="tab {{#if (eq activeTab "xp")}}active{{/if}}" data-tab="xp" data-group="main">
  <div class="rt-xp-totals">
    <div class="rt-field">
      <label>{{localize "RT.Sheet.XP.Total"}}</label>
      <input type="number" name="system.xp.total" value="{{system.xp.total}}" data-dtype="Number"/>
    </div>
    <div class="rt-field">
      <label>{{localize "RT.Sheet.XP.Spent"}}</label>
      <input type="number" value="{{system.xp.spent}}" disabled/>
    </div>
    <div class="rt-field">
      <label>{{localize "RT.Sheet.XP.Free"}}</label>
      <input type="number" value="{{system.xp.free}}" disabled/>
    </div>
  </div>

  <nav class="rt-sub-tabs">
    <button type="button" class="rt-tab-button {{#if (eq activeXpTab "characteristics")}}active{{/if}}" data-action="switchTab" data-group="xp" data-tab="characteristics">{{localize "RT.Tabs.XP.Characteristics"}}</button>
    <button type="button" class="rt-tab-button {{#if (eq activeXpTab "skills")}}active{{/if}}" data-action="switchTab" data-group="xp" data-tab="skills">{{localize "RT.Tabs.XP.Skills"}}</button>
    <button type="button" class="rt-tab-button {{#if (eq activeXpTab "talents")}}active{{/if}}" data-action="switchTab" data-group="xp" data-tab="talents">{{localize "RT.Tabs.XP.Talents"}}</button>
    <button type="button" class="rt-tab-button {{#if (eq activeXpTab "progression")}}active{{/if}}" data-action="switchTab" data-group="xp" data-tab="progression">{{localize "RT.Tabs.XP.Progression"}}</button>
  </nav>

  <section class="tab {{#if (eq activeXpTab "characteristics")}}active{{/if}}" data-tab="characteristics" data-group="xp">
    <div class="rt-xp">
      <div class="rt-xp__row rt-xp__row--header">
        <label></label>
        <label>{{localize "RT.Sheet.XP.Advance"}}</label>
        <label>{{localize "RT.Sheet.XP.BaseValue"}}</label>
        <label>{{localize "RT.Sheet.XP.BaseBonus"}}</label>
        <label>{{localize "RT.Sheet.XP.BonusModifier"}}</label>
        <label>{{localize "RT.Sheet.XP.Reduction"}}</label>
        <label>{{localize "RT.Sheet.XP.XP"}}</label>
      </div>
      {{#each characteristics as |c|}}
      <div class="rt-xp__row" title="{{c.label}}">
        <label class="rt-xp__abbr">{{c.abbr}}</label>
        <select name="system.characteristics.{{c.key}}.advance" data-dtype="Number">
          {{#each c.advanceOptions as |option|}}
          <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>+{{option.value}}</option>
          {{/each}}
        </select>
        <input type="number" name="system.characteristics.{{c.key}}.value" value="{{c.value}}" data-dtype="Number"/>
        <input type="text" disabled value="{{c.baseBonus}}"/>
        <input type="number" name="system.characteristics.{{c.key}}.bonusMod" value="{{c.bonusMod}}" data-dtype="Number" title="{{localize "RT.Sheet.XP.BonusModifierHint"}}"/>
        <input type="number" name="system.characteristics.{{c.key}}.reduction" value="{{c.reduction}}" data-dtype="Number"/>
        <input type="number" name="system.characteristics.{{c.key}}.xp" value="{{c.xp}}" data-dtype="Number"/>
      </div>
      {{/each}}
    </div>
  </section>

  <section class="tab {{#if (eq activeXpTab "skills")}}active{{/if}}" data-tab="skills" data-group="xp">
    <div class="rt-table-columns">
    <div class="rt-table-column">
    <h3 class="rt-table-title">{{localize "RT.Skills.Basic"}}</h3>
    <div class="rt-xp-skills">
      <div class="rt-xp-skills__row rt-xp-skills__row--header">
        <label>{{localize "RT.Skill.Name"}}</label>
        <label>{{localize "RT.Skills.Trained"}}</label>
        <label>+10</label>
        <label>+20</label>
        <label>{{localize "RT.Skills.Talent"}}</label>
        <label>{{localize "RT.Skills.Mod"}}</label>
        <label></label>
        <label>{{localize "RT.Sheet.XP.XP"}}</label>
      </div>
      {{#each skillsBasic as |s|}}
      <div class="rt-xp-skills__row">
        <label class="rt-xp-skills__name"><span class="rt-xp-skills__name-text">{{s.name}}</span><i class="fa-solid fa-circle-question rt-skill-help" data-tooltip="{{s.desc}}"></i></label>
        <input type="checkbox" name="system.skills.{{s.key}}.trained" {{checked s.trained}}/>
        <input type="checkbox" name="system.skills.{{s.key}}.plus10" {{checked s.plus10}}/>
        <input type="checkbox" name="system.skills.{{s.key}}.plus20" {{checked s.plus20}}/>
        <input type="number" name="system.skills.{{s.key}}.talent" value="{{s.talent}}" data-dtype="Number"/>
        <input type="number" name="system.skills.{{s.key}}.modifier" value="{{s.modifier}}" data-dtype="Number"/>
        <input type="text" disabled value="{{s.total}}"/>
        <input type="number" name="system.skills.{{s.key}}.xp" value="{{s.xp}}" data-dtype="Number"/>
      </div>
      {{/each}}
    </div>
    </div>

    <div class="rt-table-column">
    <h3 class="rt-table-title">{{localize "RT.Skills.Advanced"}}</h3>
    <div class="rt-xp-skills rt-xp-skills--advanced">
      <div class="rt-xp-skills__row rt-xp-skills__row--header">
        <label>{{localize "RT.Skill.Name"}}</label>
        <label>{{localize "RT.Skills.AsBasic"}}</label>
        <label>{{localize "RT.Skills.Trained"}}</label>
        <label>+10</label>
        <label>+20</label>
        <label>{{localize "RT.Skills.Talent"}}</label>
        <label>{{localize "RT.Skills.Mod"}}</label>
        <label></label>
        <label>{{localize "RT.Sheet.XP.XP"}}</label>
      </div>
      {{#each skillsAdvanced as |s|}}
      <div class="rt-xp-skills__row">
        <label class="rt-xp-skills__name"><span class="rt-xp-skills__name-text">{{s.name}}</span><i class="fa-solid fa-circle-question rt-skill-help" data-tooltip="{{s.desc}}"></i></label>
        <input type="checkbox" name="system.skills.{{s.key}}.asBasic" {{checked s.asBasic}}/>
        <input type="checkbox" name="system.skills.{{s.key}}.trained" {{checked s.trained}}/>
        <input type="checkbox" name="system.skills.{{s.key}}.plus10" {{checked s.plus10}}/>
        <input type="checkbox" name="system.skills.{{s.key}}.plus20" {{checked s.plus20}}/>
        <input type="number" name="system.skills.{{s.key}}.talent" value="{{s.talent}}" data-dtype="Number"/>
        <input type="number" name="system.skills.{{s.key}}.modifier" value="{{s.modifier}}" data-dtype="Number"/>
        <input type="text" disabled value="{{s.total}}"/>
        <input type="number" name="system.skills.{{s.key}}.xp" value="{{s.xp}}" data-dtype="Number"/>
      </div>
      {{/each}}
    </div>
    </div>
    </div>

    <div class="rt-table-columns">
    {{#each skillGroups as |g|}}
    <div class="rt-skill-group-table">
      <div class="rt-skill-group-table__header">
        <label class="rt-skill-group-table__name">{{g.name}}</label>
        <i class="fa-solid fa-circle-question rt-skill-help" data-tooltip="{{g.desc}}"></i>
      </div>
      {{#each g.rows as |r|}}
      <div class="rt-group-row {{#if g.editing}}has-edit{{/if}}">
        <div class="rt-group-row__name">
          <input type="text" data-gindex="{{r.index}}" data-gfield="name" value="{{r.name}}" placeholder="{{localize "RT.Skill.Name"}}"/>
          {{#if g.editing}}
          <div class="rt-row-edit">
            <button type="button" class="rt-row-edit__btn" data-action="moveGroupSkill" data-index="{{r.index}}" data-delta="-1" title="{{localize "RT.Skills.MoveUp"}}"><i class="fa-solid fa-arrow-up"></i></button>
            <button type="button" class="rt-row-edit__btn" data-action="moveGroupSkill" data-index="{{r.index}}" data-delta="1" title="{{localize "RT.Skills.MoveDown"}}"><i class="fa-solid fa-arrow-down"></i></button>
            <button type="button" class="rt-row-edit__btn" data-action="deleteGroupSkill" data-index="{{r.index}}" title="{{localize "RT.Skills.Delete"}}"><i class="fa-solid fa-trash"></i></button>
          </div>
          {{/if}}
        </div>
        <div class="rt-group-row__fields">
          <select data-gindex="{{r.index}}" data-gfield="characteristic">
            {{#each g.chars as |c|}}
            <option value="{{c.id}}" {{#if (eq r.char c.id)}}selected{{/if}}>{{c.abbr}}</option>
            {{/each}}
          </select>
          <input type="checkbox" data-gindex="{{r.index}}" data-gfield="asBasic" {{checked r.asBasic}} title="{{localize "RT.Skills.AsBasic"}}"/>
          <input type="checkbox" data-gindex="{{r.index}}" data-gfield="trained" {{checked r.trained}} title="{{localize "RT.Skills.Trained"}}"/>
          <input type="checkbox" data-gindex="{{r.index}}" data-gfield="plus10" {{checked r.plus10}} title="+10"/>
          <input type="checkbox" data-gindex="{{r.index}}" data-gfield="plus20" {{checked r.plus20}} title="+20"/>
          <input type="number" data-gindex="{{r.index}}" data-gfield="talent" value="{{r.talent}}" data-dtype="Number" title="{{localize "RT.Skills.Talent"}}"/>
          <input type="number" data-gindex="{{r.index}}" data-gfield="modifier" value="{{r.modifier}}" data-dtype="Number" title="{{localize "RT.Skills.Mod"}}"/>
          <input type="text" disabled value="{{r.total}}" title="{{localize "RT.Skills.TotalTitle"}}"/>
          <input type="number" data-gindex="{{r.index}}" data-gfield="xp" value="{{r.xp}}" data-dtype="Number" title="{{localize "RT.Sheet.XP.XP"}}"/>
        </div>
      </div>
      {{/each}}
      <div class="rt-skill-group-table__footer">
        <button type="button" class="rt-button rt-button--small" data-action="addGroupSkill" data-group="{{g.key}}" title="{{localize "RT.Skills.Add"}}">+</button>
        <button type="button" class="rt-button rt-button--small {{#if g.editing}}active{{/if}}" data-action="toggleGroupEdit" data-group="{{g.key}}" title="{{localize "RT.Skills.EditRows"}}"><i class="fa-solid fa-gear"></i></button>
      </div>
    </div>
    {{/each}}
    </div>
  </section>

  <section class="tab {{#if (eq activeXpTab "talents")}}active{{/if}}" data-tab="talents" data-group="xp">
    <div class="rt-talents-list">
      {{#each talents as |t|}}
      <div class="rt-talent-block">
        <div class="rt-talent-block__header">
          <input type="text" data-jlist="talents" data-jindex="{{t.index}}" data-jfield="name" value="{{t.name}}" placeholder="{{localize "RT.Talents.Name"}}"/>
          <input type="number" class="rt-talent-block__xp" data-jlist="talents" data-jindex="{{t.index}}" data-jfield="xp" value="{{t.xp}}" data-dtype="Number" title="{{localize "RT.Sheet.XP.XP"}}"/>
          {{#if listEdit.talents}}
          <div class="rt-row-edit">
            <button type="button" class="rt-row-edit__btn" data-action="moveListRow" data-list="talents" data-index="{{t.index}}" data-delta="-1" title="{{localize "RT.Skills.MoveUp"}}"><i class="fa-solid fa-arrow-up"></i></button>
            <button type="button" class="rt-row-edit__btn" data-action="moveListRow" data-list="talents" data-index="{{t.index}}" data-delta="1" title="{{localize "RT.Skills.MoveDown"}}"><i class="fa-solid fa-arrow-down"></i></button>
            <button type="button" class="rt-row-edit__btn" data-action="deleteListRow" data-list="talents" data-index="{{t.index}}" title="{{localize "RT.Skills.Delete"}}"><i class="fa-solid fa-trash"></i></button>
          </div>
          {{else}}
          <button type="button" class="rt-button rt-button--small" data-action="toggleTalentExpand" data-index="{{t.index}}" title="{{localize "RT.Talents.ShowDesc"}}"><i class="fa-solid fa-chevron-down"></i></button>
          <button type="button" class="rt-button rt-button--small" data-action="sendTalentToChat" data-index="{{t.index}}" title="{{localize "RT.Talents.SendToChat"}}"><i class="fa-solid fa-comment-dots"></i></button>
          {{/if}}
        </div>
        {{#if t.expanded}}
        <div class="rt-talent-block__body">
          <textarea class="rt-description" data-jlist="talents" data-jindex="{{t.index}}" data-jfield="description" rows="4">{{t.description}}</textarea>
        </div>
        {{/if}}
      </div>
      {{/each}}
    </div>
    <div class="rt-skill-group-table__footer">
      <button type="button" class="rt-button rt-button--small" data-action="addListRow" data-list="talents" title="{{localize "RT.Skills.Add"}}">+</button>
      <button type="button" class="rt-button rt-button--small {{#if listEdit.talents}}active{{/if}}" data-action="toggleListEdit" data-list="talents" title="{{localize "RT.Skills.EditRows"}}"><i class="fa-solid fa-gear"></i></button>
    </div>
  </section>

  <section class="tab {{#if (eq activeXpTab "progression")}}active{{/if}}" data-tab="progression" data-group="xp">
    <div class="rt-xp-parts">
      <div class="rt-field">
        <label>{{localize "RT.XP.ByCharacteristic"}}</label>
        <input type="text" disabled value="{{system.xp.characteristics}}"/>
      </div>
      <div class="rt-field">
        <label>{{localize "RT.XP.BySkills"}}</label>
        <input type="text" disabled value="{{system.xp.skills}}"/>
      </div>
      <div class="rt-field">
        <label>{{localize "RT.XP.ByTalents"}}</label>
        <input type="text" disabled value="{{system.xp.talents}}"/>
      </div>
      <div class="rt-field">
        <label>{{localize "RT.XP.Misc"}}</label>
        <input type="text" disabled value="{{system.xp.misc}}"/>
      </div>
    </div>

    <div class="rt-talents-list">
      {{#each progression as |p|}}
      <div class="rt-talent-block">
        <div class="rt-talent-block__header">
          <input type="text" data-jlist="progression" data-jindex="{{p.index}}" data-jfield="name" value="{{p.name}}" placeholder="{{localize "RT.Progression.Name"}}"/>
          <input type="number" class="rt-talent-block__xp" data-jlist="progression" data-jindex="{{p.index}}" data-jfield="xp" value="{{p.xp}}" data-dtype="Number" title="{{localize "RT.Sheet.XP.XP"}}"/>
          {{#if listEdit.progression}}
          <div class="rt-row-edit">
            <button type="button" class="rt-row-edit__btn" data-action="moveListRow" data-list="progression" data-index="{{p.index}}" data-delta="-1" title="{{localize "RT.Skills.MoveUp"}}"><i class="fa-solid fa-arrow-up"></i></button>
            <button type="button" class="rt-row-edit__btn" data-action="moveListRow" data-list="progression" data-index="{{p.index}}" data-delta="1" title="{{localize "RT.Skills.MoveDown"}}"><i class="fa-solid fa-arrow-down"></i></button>
            <button type="button" class="rt-row-edit__btn" data-action="deleteListRow" data-list="progression" data-index="{{p.index}}" title="{{localize "RT.Skills.Delete"}}"><i class="fa-solid fa-trash"></i></button>
          </div>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    <div class="rt-skill-group-table__footer">
      <button type="button" class="rt-button rt-button--small" data-action="addListRow" data-list="progression" title="{{localize "RT.Skills.Add"}}">+</button>
      <button type="button" class="rt-button rt-button--small {{#if listEdit.progression}}active{{/if}}" data-action="toggleListEdit" data-list="progression" title="{{localize "RT.Skills.EditRows"}}"><i class="fa-solid fa-gear"></i></button>
    </div>
  </section>
</section>
