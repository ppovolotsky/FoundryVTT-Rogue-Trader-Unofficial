<div class="rt-roll-card">
  <div class="rt-roll-card__label">{{localize "RT.Combat.DamageReceived"}}</div>
  <div class="rt-roll-card__row">{{localize "RT.Combat.Location"}}: {{locationLabel}}</div>
  <div class="rt-roll-card__row">{{localize "RT.Combat.DamageAmount"}}: {{damage}}</div>
  <div class="rt-roll-card__row">{{localize "RT.Combat.Penetration"}}: {{pen}}</div>
  <div class="rt-roll-card__row">{{localize "RT.Combat.ArmourUsed"}}: {{armour}} ({{localize "RT.Combat.EffectiveArmour"}} {{effectiveArmour}})</div>
  <div class="rt-roll-card__row">{{localize "RT.Combat.ToughnessBonus"}}: {{tb}}</div>
  <div class="rt-roll-card__result">{{localize "RT.Combat.WoundsDealt"}}: {{wounds}}</div>
</div>
