<div class="rt-roll-dialog">
  {{#if label}}
  <div class="rt-roll-dialog__label">{{label}}</div>
  {{/if}}

  <div class="form-group">
    <label>{{localize "RT.Dialog.Target"}}</label>
    <div class="form-fields">
      <input type="number" name="target" value="{{target}}" step="1"/>
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "RT.Dialog.Modifier"}}</label>
    <div class="form-fields">
      <input type="number" name="modifier" value="{{modifier}}" step="1"/>
    </div>
  </div>
</div>
